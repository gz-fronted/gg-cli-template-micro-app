{
  "name": "micro-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode development",
    "mock": "vite --mode mock",
    "build:test": "tsc -b && vite build --mode test",
    "build:prod": "tsc -b && vite build --mode production",
    "build:dev": "tsc -b && vite build --mode development",
    "build:sit": "tsc -b && vite build --mode sit",
    "build": "npm run build:prod",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "analyze": "cross-env ANALYZE=true npm run build:prod",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "lint:style": "stylelint \"src/**/*.{css,less}\"",
    "lint:style:fix": "npm run lint:style -- --fix",
    "lint:staged": "lint-staged",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,less}": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{json,jsonc,md,html,yml,yaml}": "prettier --write"
  },
  "dependencies": {
    "@ag-grid-community/locale": "36.0.1",
    "@ant-design/icons": "6.1.0",
    "@chenhui996/gg-ui": "0.1.2",
    "@garfish/bridge-react-v18": "1.19.8",
    "@gz-fronted/gz-pc": "0.1.0",
    "ag-grid-community": "36.0.1",
    "ag-grid-enterprise": "36.0.1",
    "ag-grid-react": "36.0.1",
    "antd": "6.3.3",
    "dayjs": "1.11.21",
    "echarts": "6.0.0",
    "echarts-for-react": "3.0.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-router-dom": "7.13.1",
    "tslib": "2.8.1",
    "zustand": "5.0.12"
  },
  "devDependencies": {
    "@babel/core": "7.29.0",
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@eslint/js": "9.39.4",
    "@rolldown/plugin-babel": "0.2.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/babel__core": "7.20.5",
    "@types/node": "24.12.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.0",
    "@vitest/coverage-v8": "4.1.4",
    "babel-plugin-react-compiler": "1.0.0",
    "cross-env": "10.1.0",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.5.2",
    "globals": "17.4.0",
    "husky": "9.1.7",
    "jsdom": "29.0.2",
    "less": "4.6.4",
    "lint-staged": "16.4.0",
    "msw": "2.15.0",
    "prettier": "3.8.1",
    "rollup-plugin-visualizer": "7.0.1",
    "stylelint": "17.14.1",
    "stylelint-config-recess-order": "7.7.0",
    "stylelint-config-standard-less": "4.1.0",
    "stylelint-order": "8.1.1",
    "terser": "5.46.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.56.1",
    "vite": "8.1.5",
    "vite-plugin-cdn-import": "1.0.1",
    "vite-plugin-garfish-mf": "1.0.4",
    "vitest": "4.1.4"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
